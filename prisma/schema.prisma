generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PONTO
  ANUNCIANTE
  ADMIN
}

enum StatusPonto {
  PENDENTE
  ATIVO
  INATIVO
}

enum StatusAnuncio {
  PENDENTE
  APROVADO
  REJEITADO
  ATIVO
  PAUSADO
  EXPIRADO
  FILA_ESPERA
}

enum TipoMidia {
  VIDEO
  IMAGEM
}

enum TipoNotificacao {
  ANUNCIO_PENDENTE
  ANUNCIO_APROVADO
  ANUNCIO_REJEITADO
  NOVO_ANUNCIO_TV
  FILA_ESPERA
  PONTO_ATIVADO
  PONTO_DESATIVADO
  ALERTA
  COBRANCA
  SISTEMA
  GERAL
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  senha     String
  nome      String
  whatsapp  String
  avatarUrl String?  @map("avatar_url")
  role      UserRole
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  pontoMidia    PontoMidia?
  anunciante    Anunciante?
  notificacoes  Notificacao[]

  @@map("users")
}

model PontoMidia {
  id                   Int         @id @default(autoincrement())
  userId               Int         @unique @map("user_id")
  codigoTv             String?     @unique @map("codigo_tv")
  nomeEmpresa          String      @map("nome_empresa")
  responsavel          String
  whatsapp             String
  instagramSite        String?     @map("instagram_site")
  cep                  String
  rua                  String
  numero               String
  complemento          String?
  bairro               String
  cidade               String
  uf                   String      @db.Char(2)
  categoria            String
  descricao            String
  possuiTv             Boolean     @map("possui_tv")
  quantidadeTvs        Int?        @map("quantidade_tvs")
  localInstalacao      String?     @map("local_instalacao")
  fluxoDiarioEstimado  String      @map("fluxo_diario_estimado")
  tempoPermanencia     String      @map("tempo_permanencia")
  faixaEtariaPublico   String[]    @map("faixa_etaria_publico")
  generoPublico        String      @map("genero_publico")
  horariosPico         String?     @map("horarios_pico")
  horarioAbertura      String?     @default("08:00") @map("horario_abertura")
  horarioFechamento    String?     @default("19:00") @map("horario_fechamento")
  diasFuncionamento    String[]    @default(["Segunda", "Terça", "Quarta", "Quinta", "Sexta"]) @map("dias_funcionamento")
  codigoRotativo       String?     @map("codigo_rotativo")
  codigoRotativoExpira DateTime?   @map("codigo_rotativo_expira")
  fotos                String[]    @default([])
  lat                  Float?
  lng                  Float?
  status               StatusPonto @default(PENDENTE)
  aceitaNovosAnuncios  Boolean     @default(true) @map("aceita_novos_anuncios")
  limiteTempoSegundos  Int         @default(360) @map("limite_tempo_segundos")
  ultimaAtividade      DateTime?   @map("ultima_atividade")
  tipoDispositivo      String?     @map("tipo_dispositivo")
  resolucaoTela        String?     @map("resolucao_tela")
  criadoEm             DateTime    @default(now()) @map("criado_em")
  atualizadoEm         DateTime    @updatedAt @map("atualizado_em")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  anuncios          Anuncio[]
  registroExibicoes RegistroExibicao[]

  @@index([cidade])
  @@index([status])
  @@index([codigoTv])
  @@map("pontos_midia")
}

model Anunciante {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique @map("user_id")
  nomeEmpresa             String   @map("nome_empresa")
  responsavel             String
  whatsapp                String
  instagramSite           String?  @map("instagram_site")
  logoUrl                 String?  @map("logo_url")
  fotos                   String[] @default([])
  cep                     String
  rua                     String
  numero                  String
  complemento             String?
  bairro                  String
  cidade                  String
  uf                      String   @db.Char(2)
  categoria               String
  oQueAnunciar            String   @map("o_que_anunciar")
  descricaoAnuncio        String   @map("descricao_anuncio")
  preferenciaLocalizacao  String   @map("preferencia_localizacao")
  distanciaMaxima         String?  @map("distancia_maxima")
  bairrosEspecificos      String?  @map("bairros_especificos")
  categoriasEspecificas   String[] @map("categorias_especificas")
  faixaEtariaAlvo         String[] @map("faixa_etaria_alvo")
  generoAlvo              String   @map("genero_alvo")
  criadoEm                DateTime @default(now()) @map("criado_em")
  atualizadoEm            DateTime @updatedAt @map("atualizado_em")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  anuncios Anuncio[]

  @@index([cidade])
  @@map("anunciantes")
}

model Anuncio {
  id               Int           @id @default(autoincrement())
  anuncianteId     Int           @map("anunciante_id")
  pontoMidiaId     Int           @map("ponto_midia_id")
  titulo           String
  descricao        String
  tipoMidia        TipoMidia     @map("tipo_midia")
  midiaUrl         String        @map("midia_url")
  duracaoSegundos  Int           @default(10) @map("duracao_segundos")
  status           StatusAnuncio @default(PENDENTE)
  motivoRejeicao   String?       @map("motivo_rejeicao")
  dataInicio       DateTime?     @map("data_inicio")
  dataFim          DateTime?     @map("data_fim")
  criadoEm         DateTime      @default(now()) @map("criado_em")
  atualizadoEm     DateTime      @updatedAt @map("atualizado_em")

  anunciante        Anunciante         @relation(fields: [anuncianteId], references: [id], onDelete: Cascade)
  pontoMidia        PontoMidia         @relation(fields: [pontoMidiaId], references: [id], onDelete: Cascade)
  registroExibicoes RegistroExibicao[]

  @@index([status])
  @@index([pontoMidiaId])
  @@index([anuncianteId])
  @@map("anuncios")
}

model RegistroExibicao {
  id              Int       @id @default(autoincrement())
  anuncioId       Int       @map("anuncio_id")
  pontoMidiaId    Int       @map("ponto_midia_id")
  duracaoSegundos Int       @default(10) @map("duracao_segundos")
  tipoMidia       TipoMidia @map("tipo_midia")
  exibidoEm       DateTime  @default(now()) @map("exibido_em")

  anuncio    Anuncio    @relation(fields: [anuncioId], references: [id], onDelete: Cascade)
  pontoMidia PontoMidia @relation(fields: [pontoMidiaId], references: [id], onDelete: Cascade)

  @@index([anuncioId])
  @@index([pontoMidiaId])
  @@index([exibidoEm])
  @@map("registros_exibicao")
}

model Notificacao {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  tipo      TipoNotificacao
  titulo    String
  mensagem  String
  lida      Boolean          @default(false)
  criadoEm  DateTime         @default(now()) @map("criado_em")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lida])
  @@map("notificacoes")
}
